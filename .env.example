# Solo servidor. La sesión de prueba funciona sin Spring y nunca llama a API_URL.
STAFF_AUTH_MODE=demo
# Conexión futura: STAFF_AUTH_MODE=spring (no mezcla datos de prueba).
API_URL=http://localhost:8080
# Público: endpoint STOMP de Spring; jamás contiene JWT ni credenciales.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
# El BFF de reservas públicas conserva su configuración independiente.
VILLA_SERENA_BFF_MODE=demo
# Solo servidor: archivo independiente de operaciones de Recepción de prueba.
VILLA_SERENA_RECEPTION_DEMO_PATH=.data/reception-demo.json
CANAL_BOOKING_CODIGO=
CANAL_BOOKING_CLAVE=
CANAL_EXPEDIA_CODIGO=
CANAL_EXPEDIA_CLAVE=
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
