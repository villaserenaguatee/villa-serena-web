# Solo servidor. La sesión de prueba funciona sin Spring y nunca llama a API_URL.
STAFF_AUTH_MODE=demo
# Conexión futura: STAFF_AUTH_MODE=spring (no mezcla datos de prueba).
API_URL=http://localhost:8080
# El BFF de reservas públicas conserva su configuración independiente.
VILLA_SERENA_BFF_MODE=demo
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
