{
  "name": "villa-serena-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:bff": "node --import ./tests/bff/register.mjs --test --test-isolation=none tests/bff/*.test.ts",
    "test:reception:browser": "playwright test --config tests/config/playwright/playwright.config.ts",
    "test:reception:api": "playwright test --config tests/config/playwright/playwright.reception-api.config.ts",
    "test:cuenta": "node --import ./tests/bff/register.mjs --test tests/panel/*.test.ts",
    "test:cuenta:connected": "playwright test --config tests/config/playwright/playwright.account-mock.config.ts",
    "test:cuenta:browser": "playwright test --config tests/config/playwright/playwright.account.config.ts",
    "test:staff:browser": "playwright test --config tests/config/playwright/playwright.staff.config.ts",
    "test:payments:browser": "playwright test --config tests/config/playwright/playwright.payments.config.ts",
    "test:booking:browser": "playwright test --config tests/config/playwright/playwright.booking.config.ts",
    "test:channels:browser": "playwright test --config tests/config/playwright/playwright.channels.config.ts",
    "test:operaciones:browser": "node scripts/test-operaciones-browser.cjs",
    "test:operaciones:orders": "playwright test --config tests/config/playwright/playwright.operations.config.ts",
    "test:operaciones:rooms": "playwright test --config tests/config/playwright/playwright.operations-rooms.config.ts",
    "test:operaciones:maintenance": "playwright test --config tests/config/playwright/playwright.operations-maintenance.config.ts",
    "generate:api": "openapi-typescript openapi.yaml -o src/lib/api/schema.d.ts",
    "check": "tsc --noEmit && node scripts/check-i18n.mjs",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "pnpm test:reception:browser && pnpm test:staff:browser && pnpm test:payments:browser && pnpm test:booking:browser && pnpm test:channels:browser && pnpm test:cuenta:browser && pnpm test:reception:api",
    "test:integration:mock": "pnpm test:cuenta:connected && pnpm test:operaciones:orders && pnpm test:operaciones:rooms && pnpm test:operaciones:maintenance",
    "test:ci": "pnpm check && pnpm test:bff && pnpm test:cuenta && pnpm test:unit && pnpm test:component && pnpm test:e2e && pnpm test:integration:mock"
  },
  "dependencies": {
    "@event-calendar/core": "^5.15.0",
    "@stomp/stompjs": "7.2.0",
    "@tanstack/react-query": "^5.67.1",
    "@tanstack/react-query-devtools": "^5.67.1",
    "@tanstack/react-table": "^8.21.2",
    "clsx": "^2.1.1",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "^1.16.0",
    "next": "^15.5.27",
    "next-intl": "^4.14.5",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "jsdom": "^30.1.2",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": "24.x"
  }
}
