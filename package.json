{
  "name": "villa-serena-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:bff": "node --import ./tests/bff/register.mjs --test --test-isolation=none tests/bff/*.test.ts",
    "test:reception:browser": "playwright test reception- room-detail",
    "test:cuenta": "node --import ./tests/bff/register.mjs --test tests/panel/*.test.ts",
    "test:cuenta:connected": "node scripts/test-cuenta-connected.cjs",
    "test:cuenta:browser": "node scripts/test-cuenta-browser.cjs",
    "test:staff:browser": "playwright test --config playwright.staff.config.ts",
    "test:payments:browser": "playwright test --config playwright.payments.config.ts",
    "test:booking:browser": "playwright test --config playwright.booking.config.ts",
    "test:operaciones:browser": "node scripts/test-operaciones-browser.cjs",
    "generate:api": "openapi-typescript openapi.yaml -o src/lib/api/schema.d.ts",
    "check": "tsc --noEmit && node scripts/check-i18n.mjs",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "pnpm test:reception:browser && pnpm test:staff:browser && pnpm test:payments:browser && pnpm test:booking:browser",
    "test:ci": "pnpm check && pnpm test:bff && pnpm test:cuenta && pnpm test:unit && pnpm test:component && pnpm test:e2e"
  },
  "dependencies": {
    "@event-calendar/core": "^5.15.0",
    "@stomp/stompjs": "7.2.0",
    "@tanstack/react-query": "^5.67.1",
    "@tanstack/react-query-devtools": "^5.67.1",
    "@tanstack/react-table": "^8.21.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.2.1",
    "next-intl": "^4.14.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^30.1.2",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.0.0"
}
