{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "corepack pnpm build",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "git": {
    "deploymentEnabled": {
      "fix/solo-espanol-publicado": false,
      "feat/editor-fotografico": false,
      "fix/panel-fotografico-compacto": false,
      "fix/fotografias-actuales-editor": false,
      "fix/panel-habitaciones-layout": false,
      "feat/catalogo-habitaciones-conectado": false,
      "fix/tarifas-ofertas-conectadas": false,
      "fix/menu-productos-fotografias": false
    }
  }
}
